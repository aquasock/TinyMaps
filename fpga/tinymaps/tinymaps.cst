// UART to the BL616, the loader's transport.  Same pins as TinyTang's desktop
// core: the board wires the BL616's UART1 (TX GPIO 28, RX GPIO 27) here.
IO_LOC "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;
IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

// PLL placement, from TinyTang's desktop core (the open-flow build of record on
// this board).  Without these nextpnr lands pll_nes in a row-108 gap and the
// HDMI PLL's 371.25 MHz output crosses the die on general routing.
INS_LOC "pll_27.PLL_inst"   PLL_R[1];
INS_LOC "pll_hdmi.PLL_inst" PLL_R[3];
INS_LOC "pll_nes.PLL_inst"  PLL_R[0];
// the pixel divider belongs beside the TMDS serialisers: it is what carries
// hclk5 onto the right-side HCLK lanes they take their FCLK from.
INS_LOC "div5" RIGHTSIDE[4];
